{
  "name": "atoms-demo",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web", "apps/validator"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run build --workspace @atoms/validator && playwright test",
    "test:fps": "npm run build --workspace @atoms/validator && node scripts/check-fps-runtime.mjs",
    "check": "npm run typecheck --workspaces --if-present"
  },
  "engines": {"node": ">=24 <25"},
  "devDependencies": {"@playwright/test": "1.64.1"}
}

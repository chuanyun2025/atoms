FROM public.ecr.aws/docker/library/node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS web
WORKDIR /app
COPY package*.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/validator/package.json apps/validator/package.json
RUN npm ci --registry=https://registry.npmmirror.com
COPY apps/web apps/web
COPY shared/slide-templates.json shared/slide-templates.json
RUN npm run build -w @atoms/web
FROM public.ecr.aws/docker/library/nginx:stable-alpine@sha256:583b7f2fce1cdb8da5ad5c39ebd3c33b98b87d493190e548bdee1fa8c619c311
COPY --from=web /app/apps/web/dist /usr/share/nginx/html
COPY deploy/nginx/production.conf /etc/nginx/conf.d/default.conf

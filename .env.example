APP_ENV=development
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
SESSION_SECRET=
SERVICE_TOKEN=
DATABASE_URL=sqlite:////var/lib/atoms/atoms.db
VALIDATOR_URL=http://validator:9000
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_RESPONSE_MODE=json_object
LLM_THINKING_MODE=disabled
LLM_TOKEN_LIMIT_PARAM=max_tokens
LLM_PROVIDER_MAX_OUTPUT_TOKENS=393216
LLM_REQUEST_TIMEOUT_SECONDS=1500
RUN_CONCURRENCY=3
RUN_TIMEOUT_SECONDS=3600
PENDING_TIMEOUT_SECONDS=3600
READ_ONLY_MODE=false
DATA_VOLUME_NAME=atoms_data

# Vidu native text-to-video / image-to-video
VIDU_API_KEY=
VIDU_BASE_URL=https://api.vidu.cn
VIDU_MODEL=viduq3-pro
VIDU_RESOLUTION=540p
VIDU_POLL_SECONDS=5

# Supplier purchase price per credit in CNY; charged at cost, no markup.
VIDU_CREDIT_PRICE_CNY=0.03125
